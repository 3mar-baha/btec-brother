# Supabase — replace with your project's values (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Never expose this key to the browser or commit the real value.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Telegram bot — server-side token + admin chat for notifications
TELEGRAM_BOT_TOKEN=your-bot-token
TELEGRAM_CHAT_ID=your-admin-chat-id

# Telegram bot — public identifiers (baked at build time)
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=your-bot-username
NEXT_PUBLIC_TELEGRAM_BOT_ID=your-bot-id
